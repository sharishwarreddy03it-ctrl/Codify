rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile: only owner can read and write their profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Subcollections for user data (progress, challenges, achievements, sandbox)
      match /{subcollection}/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
